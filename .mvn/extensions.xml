<?xml version="1.0" encoding="UTF-8"?>
<!--
  Loaded at Maven startup, before any POM is parsed — so the artifactregistry:// wagon is available
  for parent-POM and plugin resolution too, not only for dependencies. Declaring it only in
  pom.xml <build><extensions> is too late: the parent (spring-boot-starter-parent) is resolved
  first, and on a cold ~/.m2 cache that resolution hits this repo before the build extension loads.
-->
<extensions>
  <extension>
    <groupId>com.google.cloud.artifactregistry</groupId>
    <artifactId>artifactregistry-maven-wagon</artifactId>
    <version>2.2.0</version>
  </extension>
</extensions>
